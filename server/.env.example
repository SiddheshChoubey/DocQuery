GEMINI_API_KEY=replace_with_your_gemini_key
# Optional: GEMINI_CHAT_MODEL=your_available_model
CLERK_SECRET_KEY=replace_with_your_clerk_secret_key
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLIENT_ORIGINS=http://localhost:3000
# Alternatively use CLERK_JWT_KEY (PEM public key) instead of CLERK_SECRET_KEY.
# Production: set the exact frontend origin(s), comma-separated, and Clerk issuer.
